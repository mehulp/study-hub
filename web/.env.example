# Read by Vite at build time (Decision #87), baked into the static bundle.
# Optional for local dev -- unset, api/client.ts falls back to
# http://localhost:8000, exactly today's behavior. Only needs a real value
# when building for a deployed environment (e.g. Railway), pointed at that
# environment's real deployed Gateway URL.
VITE_GATEWAY_URL=

# InterviewPal practice packs (a plan can be paired with one in its plan form, which shows "Practise in InterviewPal").
# VITE_INTERVIEWPAL_URL is where InterviewPal runs, read at build time like VITE_GATEWAY_URL above:
#   `npm run dev` (default if unset):    http://localhost:8010/
#   production build (default if unset): https://mehulp.github.io/interview-pal/   (keep the base path and the trailing slash)
# For local runs put it in web/.env.local (git-ignored) and restart `npm run dev`. To override the production default, set it as a build
# variable (for Cloudflare: Workers Builds -> Variables) before the build runs. Leave it blank (or unset) for the defaults above.
# Do NOT leave VITE_GATEWAY_URL= blank in .env.local: a blank value stops the localhost:8000 fallback and logins fail with 404.
VITE_INTERVIEWPAL_URL=
