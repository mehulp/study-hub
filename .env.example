POSTGRES_PASSWORD=change-me
OAUTH_CLIENT_SECRET=generate-via-services/auth/create_oauth_client.py
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

# Only read by a deployed environment's entrypoint.sh (Decision #87), never
# by local docker-compose -- local dev keeps using the gitignored
# private_key.pem/public_key.pem files directly, unchanged. Only set these
# when deploying somewhere that builds from a git clone (e.g. Railway),
# which never has those files. Base64 of the full PEM file content, not
# raw PEM text -- a raw multi-line PEM pasted into a single-line dashboard
# input field loses its newlines in practice (confirmed live on Railway --
# "MalformedFraming" when Auth tried to parse it), which base64 avoids
# entirely since it has no newlines to lose. Generate with:
#   base64 -w0 services/auth/private_key.pem
#   base64 -w0 services/auth/public_key.pem
JWT_PRIVATE_KEY_PEM_B64=
JWT_PUBLIC_KEY_PEM_B64=
